{
  "mcpServers": {
    "serena": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "SERENA_DOCKER=1",
        "-e", "SERENA_HOME=/serena-data",
        "-v", "__WORKSPACE_ROOT__:__WORKSPACE_ROOT__:ro",
        "-v", "serena-cache:/root/.cache",
        "-v", "serena-data:/serena-data",
        "__SERENA_IMAGE__",
        "serena", "start-mcp-server",
        "--context", "agent",
        "--project", "__PROJECT_DIR__"
      ]
    }
  }
}
