{
  "mcpServers": {
    "serena": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "SERENA_DOCKER=1",
        "-v", "__PROJECT_DIR__:/workspace",
        "-v", "serena-cache:/root/.cache",
        "__SERENA_IMAGE__",
        "serena", "start-mcp-server",
        "--context", "claude-code",
        "--project", "/workspace"
      ]
    }
  }
}
