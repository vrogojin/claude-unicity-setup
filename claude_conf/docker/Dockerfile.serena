# syntax=docker/dockerfile:1
#
# Unicity Serena image — extends the official Serena MCP image with the Go and
# C/C++ language servers so semantic code search covers the FULL Unicity stack.
#
#   Base already provides:  Node (TypeScript/JavaScript), rust-analyzer (Rust), Python
#   This image adds:        gopls (Go: aggregator-go, bft-core), clangd (C/C++: alpha)
#
# setup.sh auto-builds and tags this (unicity/serena:<version>) the first time
# you deploy on a machine — a working Docker install is the only prerequisite.
# Manual rebuild (use the tag from your project's .mcp.json):
#   docker build -t unicity/serena:<version> -f Dockerfile.serena .
FROM ghcr.io/oraios/serena:latest

USER root
SHELL ["/bin/bash", "-c"]

# --- C/C++ language server (alpha) ---
RUN apt-get update \
    && apt-get install -y --no-install-recommends clangd \
    && rm -rf /var/lib/apt/lists/*

# --- Go toolchain + gopls (aggregator-go, bft-core) ---
# TARGETARCH is populated by BuildKit (amd64 / arm64), matching Go's release naming.
# Do NOT give it a default: a default value shadows BuildKit's per-platform value, so an
# arm64 (Apple Silicon) build would still fetch the amd64 Go tarball and fail to build.
ARG TARGETARCH
# Keep GO_VERSION current for gopls@latest: too old and `go install` below has to download
# a newer toolchain at build time (Go's auto-toolchain resolver) — a wasted ~15s + a surprise
# dependency on go.dev. Bump this when gopls needs a newer Go.
ARG GO_VERSION=1.26.7
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz
ENV GOPATH=/root/go
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
RUN go install golang.org/x/tools/gopls@latest

# The base image's ENTRYPOINT is inherited: it activates the venv and runs the
# `serena start-mcp-server ...` command passed as arguments by the MCP client.
